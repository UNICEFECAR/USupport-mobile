{
  "expo": {
    "name": "uSupport",
    "slug": "uSupport",
    "scheme": "usupport",
    "version": "1.0.0",
    "orientation": "portrait",
    "android": {
      "googleServicesFile": "./android/app/google-services.json",
      "package": "org.unicef.ecar.usupport"
    },
    "ios": {
      "bundleIdentifier": "org.unicef.ecar.usupport",
      "supportsTablet": false,
      "googleServicesFile": "./ios/GoogleService-Info.plist"
    },
    "jsEngine": "hermes",
    "extra": {
      "eas": {
        "projectId": "94d84ded-b71b-4716-b049-e53d470a99de"
      }
    },
    "assetBundlePatterns": [
      "src/assets/**/*"
    ],
    "plugins": [
      "expo-local-authentication",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": true
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      ["@stripe/stripe-react-native",{"merchantIdentifier":"merchant.org.unicef.ecar.usupport","enableGooglePay":false}],
      "react-native-bootsplash"
    ]
  }
}
